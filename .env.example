# defualt values
DEFAULT_OLLAMA_MODEL="MODEL_NAME"



# agent spicifc values
ROUTER_OLLAMA_MODEL="MODEL_NAME"
DECOMPOSE_OLLAMA_MODEL="MODEL_NAME"
SUBAGENT_OLLAMA_MODEL="MODEL_NAME"
DYNAMIC_AGENT_LLM="MODEL_NAME"
DEEP_RESEARCHER_LLM="MODEL_NAME"

#  API keys
TAVILY_API_KEY="API_KEY"
LANGSMITH_API_KEY="API_KEY"
LANGSMITH_TRACING_V2="BOOLEAN"
LANGSMITH_PROJECT="NAME"
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
OLLAMA_API_KEY="API_KEY"

# Docker Compose: host port for Ollama UI/API from host machine (container stays 11434).
# OLLAMA_PUBLISH_PORT=2400
# Backend: extra stdout lines for ollama_client (see docker compose logs -f backend).
# WINGMAN_DEBUG_OLLAMA=1

# Chat: skip Postgres for chat history; keep messages in process memory only (lost on restart).
# WINGMAN_CHAT_MEMORY_ONLY=1

# ReAct web agent wall-clock cap (backend) and httpx read budget (Telegram defaults match if unset).
# WINGMAN_AGENT_MAX_SEC=300
# TELEGRAM_BACKEND_TIMEOUT_SEC=300
# TELEGRAM_WEB_AGENT_TIMEOUT_SEC=300

# Ollama HTTP base (LangChain / ollama SDK). For ``uv run`` on the host, use http://127.0.0.1:11434
# (or your host publish port). For ``docker compose``, backend service sets
# ``OLLAMA_BASE_URL=http://ollama:11434`` in docker-compose.yml — value here is ignored there.
OLLAMA_BASE_URL=''
DATA_FOLDER_PATH=''
TRACELOOP_API_KEY=''
OPENAI_API_KEY=''
LOG_LEVEL=''
DEBUG=''
ARTIFACTS_FOLDER_PATH=''
LOGGING_FOLDER_PATH=''

# Telegram bot tokens
TELEGRAM_BOT_TOKEN="BOT_TOKEN"
TELEGRAM_BOT_CHAT_ID="CHAT_ID"